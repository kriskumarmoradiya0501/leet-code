class Solution {
    public int[] getConcatenation(int[] nums) {
        int k = 0;
        int[] ans = new int[nums.length * 2];
        for(int j = 0; j < 2; j++){
            for(int i = 0; i < nums.length; i++){
                ans[k] = nums[i];
                k++;
            }
        }
        return ans;
    }
}
